      ],
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "\n",
        "torch.manual_seed(42)\n",
        "\n",
        "# 데이터 30개, 입력 특성 4개 생성\n",
        "X = torch.randn(30, 4)\n",
        "\n",
        "# 학습에 사용할 정답 y 생성\n",
        "# y = 2*x1 - x2 + 0.5*x3 + 3*x4 + 0.7\n",
        "w = torch.tensor([[2.0], [-1.0], [0.5], [3.0]])\n",
        "y = X @ w + 0.7\n",
        "\n",
        "\n",
        "class MyDataset(Dataset):\n",
        "\n",
        "    # __init__: 입력 데이터와 정답 데이터를 저장\n",
        "    def __init__(self, X, y):\n",
        "        self.X = X\n",
        "        self.y = y\n",
        "\n",
        "    # __len__: 전체 데이터 개수 반환\n",
        "    def __len__(self):\n",
        "        return len(self.X)\n",
        "\n",
        "    # __getitem__: 지정된 인덱스의 입력과 정답 반환\n",
        "    def __getitem__(self, idx):\n",
        "        return self.X[idx], self.y[idx]\n",
        "\n",
        "\n",
        "# 사용자 정의 Dataset 생성\n",
        "dataset = MyDataset(X, y)\n",
        "\n",
        "print(\"전체 데이터 개수:\", len(dataset))\n",
        "print(\"입력 데이터 Shape:\", X.shape)\n",
        "print(\"정답 데이터 Shape:\", y.shape)\n",
        "\n",
        "# 첫 번째 데이터 확인\n",
        "x0, y0 = dataset[0]\n",
        "\n",
        "print(\"첫 번째 입력:\", x0)\n",
        "print(\"첫 번째 정답:\", y0)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Batch Size 7, 순서 유지, 마지막 Batch 사용\n",
        "loader = DataLoader(\n",
        "    dataset,\n",
        "    batch_size=7,\n",
        "    shuffle=False,\n",
        "    drop_last=False\n",
        ")\n",
        "\n",
        "print(\"전체 Batch 개수:\", len(loader))\n",
        "print()\n",
        "\n",
        "for i, (bx, by) in enumerate(loader):\n",
        "    print(f\"Batch {i+1}\")\n",
        "    print(\"입력 Shape:\", bx.shape)\n",
        "    print(\"정답 Shape:\", by.shape)\n",
        "    print(\"-\" * 30)\n",
        "\n",
        "print(\"마지막 Batch 크기가 다른 이유:\")\n",
        "print(\"전체 데이터가 30개이므로 7개씩 4번 가져오고,\")\n",
        "print(\"남은 2개가 마지막 Batch에 포함되기 때문입니다.\")"
      ],
