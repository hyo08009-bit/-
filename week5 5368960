      }
    },
    {
      "cell_type": "code",
      "source": [
        "# 학습할 때는 데이터를 섞어서 사용\n",
        "train_loader = DataLoader(\n",
        "    dataset,\n",
        "    batch_size=7,\n",
        "    shuffle=True\n",
        ")\n",
        "\n",
        "# 입력 특성 4개, 출력 1개인 선형 모델\n",
        "model = nn.Linear(4, 1)\n",
        "\n",
        "# 손실 함수: 평균제곱오차\n",
        "loss_fn = nn.MSELoss()\n",
        "\n",
        "# 최적화 함수: 확률적 경사하강법\n",
        "optimizer = torch.optim.SGD(\n",
        "    model.parameters(),\n",
        "    lr=0.05\n",
        ")\n",
        "\n",
        "# 학습 횟수\n",
        "epochs = 40\n",
        "\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    model.train()\n",
        "    total_loss = 0.0\n",
        "\n",
        "    for bx, by in train_loader:\n",
        "\n",
        "        # 1. 예측\n",
        "        pred = model(bx)\n",
        "\n",
        "        # 2. 손실 계산\n",
        "        loss = loss_fn(pred, by)\n",
        "\n",
        "        # 3. 기울기 초기화\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        # 4. 역전파\n",
        "        loss.backward()\n",
        "\n",
        "        # 5. 가중치 수정\n",
        "        optimizer.step()\n",
        "\n",
        "        # Batch별 손실 누적\n",
        "        total_loss += loss.item() * bx.shape[0]\n",
        "\n",
        "    # Epoch 평균 손실 계산\n",
        "    avg_loss = total_loss / len(dataset)\n",
        "\n",
        "    print(f\"Epoch {epoch+1:02d} | 평균 손실: {avg_loss:.6f}\")\n",
        "\n",
        "\n",
        "# 학습된 가중치와 편향 확인\n",
        "print(\"\\n학습 완료\")\n",
        "print(\"학습된 가중치:\", model.weight.data)\n",
        "print(\"학습된 편향:\", model.bias.data)"
      ],
