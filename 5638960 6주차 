      "cell_type": "code",
      "source": [
        "# nn.Module을 상속하여 은닉층 2개 모델 정의\n",
        "class TwoHiddenNet(nn.Module):\n",
        "\n",
        "    # 모델에 사용할 계층 초기화\n",
        "    def __init__(self):\n",
        "        super().__init__()                # 부모 클래스 초기화\n",
        "        self.fc1 = nn.Linear(5, 16)       # 입력 5개 -> 은닉 16개\n",
        "        self.relu1 = nn.ReLU()            # 첫 번째 활성화 함수\n",
        "        self.fc2 = nn.Linear(16, 16)      # 은닉 16개 -> 은닉 16개\n",
        "        self.relu2 = nn.ReLU()            # 두 번째 활성화 함수\n",
        "        self.fc3 = nn.Linear(16, 3)       # 은닉 16개 -> 출력 3개\n",
        "\n",
        "    # 입력 데이터의 순전파 과정 정의\n",
        "    def forward(self, x):\n",
        "        x = self.fc1(x)                   # 첫 번째 선형 계층\n",
        "        x = self.relu1(x)                 # 첫 번째 ReLU 적용\n",
        "        x = self.fc2(x)                   # 두 번째 선형 계층\n",
        "        x = self.relu2(x)                 # 두 번째 ReLU 적용\n",
        "        x = self.fc3(x)                   # 출력 계층\n",
        "        return x                          # 최종 출력 반환\n",
        "\n",
        "\n",
        "# 모델 생성\n",
        "model2 = TwoHiddenNet()\n",
        "\n",
        "# 모델 구조 출력\n",
        "print(model2)"
      ],
