        "import torch\n",
        "import torch.nn as nn\n",
        "import pandas as pd\n",
        "\n",
        "torch.manual_seed(0)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# nn.Module을 상속하여 은닉층 1개 모델 정의\n",
        "class OneHiddenNet(nn.Module):\n",
        "\n",
        "    # 모델에 사용할 계층 초기화\n",
        "    def __init__(self):\n",
        "        super().__init__()               # 부모 클래스 초기화\n",
        "        self.fc1 = nn.Linear(5, 16)      # 입력 5개 -> 은닉 16개\n",
        "        self.relu = nn.ReLU()            # 활성화 함수\n",
        "        self.fc2 = nn.Linear(16, 3)      # 은닉 16개 -> 출력 3개\n",
        "\n",
        "    # 입력 데이터의 순전파 과정 정의\n",
        "    def forward(self, x):\n",
        "        x = self.fc1(x)                  # 첫 번째 선형 계층 통과\n",
        "        x = self.relu(x)                 # ReLU 활성화 함수 적용\n",
        "        x = self.fc2(x)                  # 출력 계층 통과\n",
        "        return x                         # 최종 출력 반환\n",
        "\n",
        "\n",
        "# 모델 생성\n",
        "model1 = OneHiddenNet()\n",
        "\n",
        "# 모델 구조 출력\n",
        "print(model1)"
      ],
