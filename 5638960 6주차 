      "cell_type": "code",
      "source": [
        "# 동일한 입력 데이터 생성\n",
        "x = torch.randn(8, 5)\n",
        "\n",
        "# Linear 계층 수 계산\n",
        "def count_linear(model):\n",
        "    return sum(\n",
        "        1 for layer in model.modules()\n",
        "        if isinstance(layer, nn.Linear)\n",
        "    )\n",
        "\n",
        "# 전체 학습 파라미터 수 계산\n",
        "def count_params(model):\n",
        "    return sum(p.numel() for p in model.parameters())\n",
        "\n",
        "# ReLU 활성화 함수 개수 계산\n",
        "def count_relu(model):\n",
        "    return sum(\n",
        "        1 for layer in model.modules()\n",
        "        if isinstance(layer, nn.ReLU)\n",
        "    )\n",
        "\n",
